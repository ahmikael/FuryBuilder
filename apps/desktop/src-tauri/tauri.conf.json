{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuryBuilder",
  "version": "0.1.0",
  "identifier": "com.furybuilder.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FuryBuilder",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#18191c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' http://127.0.0.1:1420; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NTVFRTI3NzlGRTE3RjkKUldUNUYvNTVKKzVWWlV1MUczS2hOWUl3RjBBWm8zVEk2ZGxyL0JWT1BGU0t2TjI1WHFiS0Z6YngK",
      "endpoints": ["https://github.com/ahmikael/FuryBuilder/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "publisher": "FuryBuilder contributors",
    "copyright": "Copyright (c) 2026 FuryBuilder contributors",
    "licenseFile": "../../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "3D studio for Minecraft Java worlds",
    "longDescription": "FuryBuilder is an offline-first 3D editor for creating, inspecting and exporting Minecraft Java Edition worlds and structures.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "wix": {
        "upgradeCode": "ed1f6f4c-a0f3-52c1-8d7a-18326f6a292c",
        "language": "en-US"
      }
    }
  }
}
