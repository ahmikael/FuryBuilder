{
  "name": "furybuilder",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first 3D studio for Minecraft Java worlds and structures",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @furybuilder/desktop dev",
    "build": "pnpm --filter @furybuilder/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "tauri": "pnpm --filter @furybuilder/desktop tauri",
    "tauri:dev": "pnpm --filter @furybuilder/desktop tauri dev",
    "tauri:build": "pnpm --filter @furybuilder/desktop tauri build",
    "release:notes": "node scripts/release-notes.mjs",
    "test:release-notes": "node --test scripts/release-notes.test.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "licenses:check": "node scripts/check-dependencies.mjs --check",
    "licenses:update": "node scripts/check-dependencies.mjs"
  }
}
